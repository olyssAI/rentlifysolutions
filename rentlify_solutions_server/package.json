{
  "name": "rentlify_solutions_server",
  "version": "1.0.0",
  "description": "Rentlify Solutions backend API",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "db:generate": "pnpm --filter @rentlify/authorization-contracts build && drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "auth:generate": "pnpm dlx auth@1.6.29 generate --config src/modules/authentication/authentication.ts --output src/database/schema/auth-schema.ts --yes",
    "seed:platform": "tsx src/database/seeds/seed-platform-catalog.ts",
    "seed:super-admin": "tsx src/database/seeds/seed-super-administrator.ts",
    "test:authentication": "tsx src/tests/authentication-integration-test.ts",
    "test:client-ip": "tsx src/tests/client-ip-resolution.ts",
    "test:permissions": "tsx src/tests/authorization-permission-catalog-test.ts",
    "test:cloudinary-preset": "tsx src/tests/cloudinary-menu-upload-preset-security-test.ts",
    "test:cloudinary-signed-upload": "tsx src/tests/cloudinary-signed-upload-integration-test.ts",
    "configure:cloudinary-preset": "tsx src/scripts/configure-cloudinary-menu-upload-preset.ts",
    "cleanup:abandoned-menu-media": "tsx src/scripts/cleanup-abandoned-menu-media.ts",
    "test:restaurants": "tsx src/tests/restaurant-workflow-integration-test.ts",
    "test:restaurant-owner-access": "tsx src/tests/restaurant-owner-access-integration-test.ts",
    "test:ordering": "tsx src/tests/ordering-integration-test.ts",
    "test:entitlements": "tsx src/tests/entitlement-enforcement-test.ts",
    "test:contact": "tsx src/tests/contact-enquiry-integration-test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@better-auth/expo": "1.6.29",
    "@rentlify/authorization-contracts": "workspace:*",
    "better-auth": "^1.6.29",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
