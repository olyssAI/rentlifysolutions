NODE_ENV=development
PORT=8000

# PostgreSQL connection string used by the API, migrations, and seed command.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rentlify_solutions

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8000
# Comma-separated exact origins. A trailing slash is normalized away.
FRONTEND_ORIGINS=http://localhost:5174
MARKETING_SITE_ORIGINS=http://localhost:3000

# Comma-separated IP addresses or CIDR ranges of the reverse proxies in front of this API.
# Both Express and Better Auth's client-IP resolution read this list. Leave empty for direct
# local connections. Required in production: without it a forwarded header is either
# spoofable (defeating sign-in rate limits) or unresolvable (one shared bucket for everyone).
# Example: TRUSTED_PROXY_IPS=10.0.0.0/8,172.31.0.0/16
TRUSTED_PROXY_IPS=

# Development uses lax/false. Unrelated production domains require none/true.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Used only by: pnpm seed:super-admin
SUPER_ADMIN_NAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional until menu image uploads are used. Configure all three together.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# A signed Cloudinary upload preset allowing only JPG, JPEG, PNG, and WebP images.
# This signed-preset API does not persist max_file_size; the application independently
# enforces the 5 MB limit before persistence. Verify the preset with test:cloudinary-preset.
CLOUDINARY_MENU_UPLOAD_PRESET=
